rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil — cada usuario solo puede subir la suya
    match /perfiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Comprobantes de movimientos — Editor/Admin
    match /comprobantes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.rol == 'editor' ||
        request.auth.token.rol == 'admin'
      );
    }

    // Comprobantes de pagos pendientes — cualquier autenticado puede subir el suyo
    match /comprobantes/pagos_pendientes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Resúmenes bancarios — Editor/Admin
    match /resumenes_bancarios/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.rol == 'editor' ||
        request.auth.token.rol == 'admin'
      );
    }

    // Configuración (logo) — solo Admin
    match /configuracion/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.rol == 'admin';
    }

  }
}
